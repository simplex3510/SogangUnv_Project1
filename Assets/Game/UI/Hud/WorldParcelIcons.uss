/* 월드 물류 아이콘(Story 026). 배송지·처분장 위에 뜨는 아이콘 묶음. 위치(left/top)는 C#이 매 프레임 정한다 */
.world-icons-hud {
    --world-icon-size: 40px;   /* TODO(tuning) */
    flex-grow: 1;
}

/* 위: 미배송(물류센터 대기) 패널, 아래: 배송중(차량 적재) 패널. 빈 패널은 C#이 숨긴다 */
.world-icon-group {
    position: absolute;
    flex-direction: column;
    align-items: center;
    width: 220px; /* 아이콘 4개가 한 줄에 들어가는 폭 */
    translate: -50% -100%;
}

.world-icon-panel {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    margin-top: 4px;
    padding: 3px 3px 0 3px;
    border-radius: 6px;
    background-color: rgba(20, 24, 30, 0.45); /* TODO(tuning) */
}

.world-icon {
    width: var(--world-icon-size);
    height: var(--world-icon-size);
    margin: 1px 5px 10px 5px; /* TODO(tuning) */
}

/* 미배송은 유형 색은 두고 밝기만 낮춰 비활성 느낌을 준다(폐기 회색과 구분되게 채도는 유지) */
.world-icon-panel--waiting .parcel-icon,
.world-icon-panel--waiting .world-icon-bar {
    opacity: 0.45; /* TODO(tuning) */
}

.world-icon .parcel-icon {
    width: 100%;
    height: 100%;
    margin: 0;
}

.world-icon-bar {
    position: absolute;
    left: 0;
    bottom: -9px;
    height: 8px;
    border-width: 1px;
    border-color: rgb(20, 40, 28);
    background-color: rgb(84, 217, 140);
}

/* Express 남은 시간은 빨강, Fresh 신선도는 초록(적재 HUD·물류센터와 같은 색) */
.world-icon-bar--express {
    border-color: rgb(50, 20, 22);
    background-color: rgb(240, 90, 95);
}
