/* 임시 GUI(Story 006). 팔레트: 어두운 슬레이트 패널, 밝은 테두리, 흰 글자, 회색 칩 */
/* 한글 표시용 OS 동적 폰트(맑은 고딕). 자식 글자에 상속된다 */
.hud-root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("MalgunGothicDynamic.asset");
}

.cargo-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 340px;
    padding: 12px 12px 2px 12px;
    background-color: rgba(38, 44, 54, 0.92);
    border-width: 3px;
    border-color: rgb(78, 88, 104);
    border-radius: 18px;
}

.cargo-panel--empty {
    display: none;
}

.cargo-group {
    margin-bottom: 10px;
    padding: 10px;
    background-color: rgb(44, 51, 62);
    border-width: 2px;
    border-color: rgb(78, 88, 104);
    border-radius: 14px;
}

.cargo-group-header {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    font-size: 20px;
    -unity-font-style: bold;
}

.cargo-group-title {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.cargo-group-count {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 18px;
}

.parcel-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 8px;
    background-color: rgb(58, 66, 79);
    border-radius: 10px;
}

.parcel-row--spoiled {
    opacity: 0.55;
}

.parcel-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    background-color: rgb(40, 120, 230);
    border-radius: 6px;
}

.parcel-icon--express {
    background-color: rgb(225, 50, 60);
}

.parcel-info {
    flex-grow: 1;
}

.parcel-price {
    font-size: 18px;
}

.parcel-tags {
    flex-direction: row;
    flex-wrap: wrap;
}

.tag-chip {
    margin-top: 2px;
    margin-right: 4px;
    padding: 1px 8px;
    font-size: 12px;
    background-color: rgb(96, 106, 122);
    border-radius: 8px;
}

.tag-chip--spoiled {
    background-color: rgb(200, 60, 60);
}

.parcel-durability {
    font-size: 13px;
    -unity-text-align: middle-right;
}

.discard-notice {
    position: absolute;
    top: 210px;
    left: 50%;
    translate: -50% 0;
    padding: 10px 24px;
    font-size: 22px;
    background-color: rgba(38, 44, 54, 0.95);
    border-width: 2px;
    border-color: rgb(230, 80, 80);
    border-radius: 14px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.discard-notice--visible {
    opacity: 1;
}

/* 위치(left/top)는 C#이 매 프레임 차량을 따라 정한다. 기준점을 글자 아래 가운데로 맞춘다 */
.damage-popup {
    position: absolute;
    translate: -50% -100%;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 70, 70);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 10, 10);
}
