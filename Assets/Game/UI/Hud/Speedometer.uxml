<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hud="Game.UI.Hud">
    <ui:Style src="Speedometer.uss" />
    <ui:VisualElement name="speedometerRoot" class="speedometer-root" picking-mode="Ignore">
        <ui:VisualElement name="speedometer" class="speedometer" picking-mode="Ignore">
            <hud:SpeedArc name="speedArc" class="speed-arc" picking-mode="Ignore">
                <ui:Label name="speedValue" text="0" class="speed-value" picking-mode="Ignore" />
                <ui:Label name="speedUnit" text="km/h" class="speed-unit" picking-mode="Ignore" />
            </hud:SpeedArc>
            <ui:VisualElement name="fastGauge" class="fast-gauge" picking-mode="Ignore">
                <ui:VisualElement name="fastGaugeFill" class="fast-gauge-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
