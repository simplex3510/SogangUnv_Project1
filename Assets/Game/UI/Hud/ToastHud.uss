/* 임시 GUI(Story 021). StatusHud와 같은 슬레이트 팔레트·한글 폰트 */

/* ── 토스트 설정: 색은 여기 변수만 고친다. 유지 시간·최대 개수는 ToastHud 컴포넌트 Inspector ── */
.toast-hud {
    --toast-parcel-bg: rgba(38, 44, 54, 0.95);
    --toast-parcel-border: rgb(78, 120, 180);
    --toast-parcel-text: rgb(255, 255, 255);

    --toast-blocked-bg: rgba(38, 44, 54, 0.95);
    --toast-blocked-border: rgb(200, 150, 60);
    --toast-blocked-text: rgb(255, 255, 255);

    --toast-spoiled-bg: rgba(60, 30, 34, 0.95);
    --toast-spoiled-border: rgb(200, 70, 70);
    --toast-spoiled-text: rgb(255, 255, 255);

    flex-grow: 1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("MalgunGothicDynamic.asset");
}

/* 상단 중앙. 최신 알림을 맨 위에 넣는다(C#이 Insert(0)) */
.toast-stack {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

/* 기본 상태 = 위로 비켜 투명. 등장·퇴장 모두 이 상태와 --shown 사이 0.3초 transition (TODO(tuning)) */
.toast {
    margin-bottom: 8px;
    padding: 10px 24px;
    font-size: 22px;
    border-width: 2px;
    border-radius: 14px;
    opacity: 0;
    translate: 0 -24px;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.toast--shown {
    opacity: 1;
    translate: 0 0;
}

/* 종류별 모양. C#이 종류에 맞는 클래스 하나를 붙인다 */
.toast--parcel {
    background-color: var(--toast-parcel-bg);
    border-color: var(--toast-parcel-border);
    color: var(--toast-parcel-text);
}

.toast--blocked {
    background-color: var(--toast-blocked-bg);
    border-color: var(--toast-blocked-border);
    color: var(--toast-blocked-text);
}

.toast--spoiled {
    background-color: var(--toast-spoiled-bg);
    border-color: var(--toast-spoiled-border);
    color: var(--toast-spoiled-text);
}
