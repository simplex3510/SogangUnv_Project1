.speedometer-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.speedometer {
    width: 220px;
    padding: 12px 16px 14px 16px;
    align-items: center;
    background-color: rgba(42, 49, 61, 0.85);
    border-width: 2px;
    border-color: rgba(70, 80, 95, 1);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.speed-arc {
    width: 170px;
    height: 150px;
    justify-content: center;
    align-items: center;
}

.speed-value {
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    font-size: 54px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding: 0;
    margin: 12px 0 0 0;
}

.speed-unit {
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    font-size: 18px;
    color: rgb(200, 208, 220);
    padding: 0;
    margin: -6px 0 0 0;
}

.fast-gauge {
    width: 100%;
    height: 16px;
    margin-top: 4px;
    background-color: rgb(82, 92, 107);
    border-width: 3px;
    border-color: rgb(44, 51, 63);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    overflow: hidden;
}

.fast-gauge-fill {
    height: 100%;
    background-color: rgb(64, 217, 140);
}

.fast-gauge--exhausted .fast-gauge-fill {
    background-color: rgb(255, 153, 26);
}
