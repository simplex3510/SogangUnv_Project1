<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="StatusHud.uss" />
    <ui:VisualElement name="statusHud" class="status-hud" picking-mode="Ignore">
        <ui:VisualElement name="statusColumn" class="status-column" picking-mode="Ignore">
            <ui:VisualElement name="statusBlock" class="status-panel" picking-mode="Ignore">
                <ui:Label name="clockTime" text="00:00" class="clock-time" picking-mode="Ignore" />
                <ui:Label name="dayLabel" text="DAY 1" class="day-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="incomePanel" class="status-panel income-panel" picking-mode="Ignore">
                <ui:VisualElement name="incomeIcon" class="income-icon" picking-mode="Ignore" />
                <ui:Label name="incomeLabel" text="0" class="income-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
