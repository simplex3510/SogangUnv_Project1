<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ToastHud.uss" />
    <ui:Template name="ToastItem" src="ToastItem.uxml" />
    <ui:VisualElement name="toastHud" class="toast-hud" picking-mode="Ignore">
        <ui:VisualElement name="toastStack" class="toast-stack" picking-mode="Ignore">
            <ui:Instance template="ToastItem" name="sample" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
