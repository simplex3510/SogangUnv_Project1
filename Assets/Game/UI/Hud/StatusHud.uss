/* 임시 GUI(Story 015). DurabilityHud와 같은 슬레이트 팔레트·한글 폰트 */
.status-hud {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("MalgunGothicDynamic.asset");
}

.status-hud--hidden {
    display: none;
}

/* 일차·시각 패널과 수익 패널을 좌상단에 세로로 쌓고 폭을 맞춘다 */
.status-column {
    position: absolute;
    top: 24px;
    left: 24px;
    min-width: 168px;
    align-items: stretch;
}

/* 두 패널의 좌우 여백을 같게 해 시각 숫자와 아이콘의 왼쪽 선을 맞춘다 */
.status-panel {
    padding: 10px 18px 12px 18px;
    background-color: rgba(38, 44, 54, 0.92);
    border-width: 3px;
    border-color: rgb(78, 88, 104);
    border-radius: 18px;
}

/* 시각은 크게 위, 일차는 작게 아래 (TODO(tuning)) */
.clock-time {
    font-size: 40px;
    -unity-font-style: bold;
}

.day-label {
    margin-top: -2px;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.65);
}

/* 오늘 수익 패널: 왼쪽 아이콘, 오른쪽 금액 (TODO(tuning)) */
.income-panel {
    margin-top: 10px;
    padding: 10px 18px;
    flex-direction: row;
    align-items: center;
}

/* 수익 아이콘(Bootstrap Icons cash-stack) */
.income-icon {
    width: 26px;
    height: 26px;
    margin-right: 12px;
    background-image: url("../Icons/cash-stack.svg");
    -unity-background-scale-mode: scale-to-fit;
}

/* 금액은 오른쪽 정렬해 자릿수가 늘어도 끝선이 고정된다 */
.income-label {
    flex-grow: 1;
    padding: 0;
    margin: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(255, 255, 255);
}

/* 음수 경고색. SettlementUI._lossColor(0.95, 0.40, 0.35)와 같다 (TODO(tuning)) */
.income-label--loss {
    color: rgb(242, 102, 89);
}
