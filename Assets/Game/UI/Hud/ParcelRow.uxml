<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DurabilityHud.uss" />
    <ui:VisualElement name="row" class="parcel-row" picking-mode="Ignore">
        <ui:VisualElement name="parcelIcon" class="parcel-icon" picking-mode="Ignore" />
        <ui:VisualElement name="info" class="parcel-info" picking-mode="Ignore">
            <ui:Label name="priceLabel" class="parcel-price" picking-mode="Ignore" text="1,000₩" />
            <ui:VisualElement name="deadline" class="parcel-deadline" picking-mode="Ignore">
                <ui:VisualElement name="deadlineFill" class="parcel-deadline-fill" picking-mode="Ignore" style="width: 60%;" />
            </ui:VisualElement>
            <ui:VisualElement name="tags" class="parcel-tags" picking-mode="Ignore">
                <ui:Label name="tagSpoiled" class="tag-chip tag-chip--spoiled" picking-mode="Ignore" text="#폐기" />
                <ui:Label name="tagOverdue" class="tag-chip tag-chip--overdue" picking-mode="Ignore" text="#지연" />
                <ui:Label name="tagFragile" class="tag-chip" picking-mode="Ignore" text="#취급주의" />
                <ui:Label name="tagHeavy" class="tag-chip" picking-mode="Ignore" text="#고중량" />
                <ui:Label name="tagLarge" class="tag-chip" picking-mode="Ignore" text="#대형" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="durabilityLabel" class="parcel-durability" picking-mode="Ignore" text="내구도 100/100" />
    </ui:VisualElement>
</ui:UXML>
